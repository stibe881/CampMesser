# Vorlage für den Selbstbetrieb (z. B. Hetzner Webhosting mit Node.js).
# Auf dem Server kopieren:  cp env.hetzner.template .env  &&  chmod 600 .env

# --- Pflicht ---
# Verbindung zur MySQL-Datenbank. Sonderzeichen im Passwort URL-kodieren (@ = %40).
DATABASE_URL=mysql://benutzer:passwort@localhost:3306/campmesser

# Zufälliges Geheimnis zum Signieren der Anmelde-Sitzungen.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Betriebsmodus - fuer den Livebetrieb immer "production".
NODE_ENV=production

# Port, auf dem der Server lauscht (Vorgabe des Hosters uebernehmen).
PORT=3000

# --- Optional: E-Mail-Versand fuer "Passwort vergessen" ---
# Ohne diese Angaben wird der Ruecksetz-Code nur ins Logfile geschrieben.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@deinedomain.ch
