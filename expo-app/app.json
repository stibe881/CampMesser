{
  "expo": {
    "name": "ReiseKompass",
    "slug": "campmesser",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.campmesser.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Wird benötigt, um Fotos für das Reisetagebuch und das Inventar aufzunehmen.",
        "NSLocationWhenInUseUsageDescription": "Wird benötigt, um Wetterdaten und Ausflugsziele in deiner Nähe anzuzeigen.",
        "NSPhotoLibraryUsageDescription": "Wird benötigt, um bestehende Fotos für das Reisetagebuch auszuwählen.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": ["comgooglemaps", "maps", "waze"]
      },
      "appleTeamId": "QF59FHQ44R",
      "entitlements": {
        "com.apple.security.application-groups": ["group.ch.campmesser.app"]
      }
    },
    "android": {
      "package": "ch.campmesser.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/icon.png"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c19e96bf-f5b5-44e7-8caf-254cbe32986b"
      }
    },
    "plugins": [
      [
        "expo-quick-actions",
        {
          "iosActions": [
            {
              "id": "sos",
              "title": "SOS",
              "subtitle": "Standort und Notfallnummern",
              "icon": "symbol:cross.case.fill",
              "params": {
                "url": "/sos"
              }
            },
            {
              "id": "weather",
              "title": "Wetter",
              "subtitle": "Vorhersage und Warnungen",
              "icon": "symbol:cloud.sun.fill",
              "params": {
                "url": "/wetter"
              }
            },
            {
              "id": "shopping",
              "title": "Einkauf",
              "subtitle": "Offene Einkäufe abhaken",
              "icon": "symbol:cart.fill",
              "params": {
                "url": "/einkauf"
              }
            },
            {
              "id": "level",
              "title": "Wasserwaage",
              "subtitle": "Wohnwagen ausrichten",
              "icon": "symbol:ruler.fill",
              "params": {
                "url": "/wasserwaage"
              }
            }
          ]
        }
      ],
      "@bacons/apple-targets"
    ],
    "scheme": "campmesser"
  }
}
